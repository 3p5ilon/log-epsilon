---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { PROJECT_SECTIONS } from "../lib/projects";
---

<Layout title="Labs" desc="Some projects and experiments">
  <div class="space-y-10">
    <header class="space-y-4">
    <h1 class="text-2xl font-semibold">labs</h1>
    <div class="mt-5 flex items-start gap-2 text-text-muted italic text-[15px]">
      <span class="shrink-0 text-theme-link">&gt;</span>
      <p>some of the projects and experiments i've enjoyed building <br/> for everything else, checkout my {" "}
        <a
            href="https://github.com/3p5ilon"
            target="_blank"
            rel="noopener noreferrer"
            class="text-theme-link not-italic hover:underline"
          >
            github
          </a>
        </p>
    </div>
    </header>

    {
      PROJECT_SECTIONS.map((section) => (
        <section class="space-y-4">
          <h2 class="text-xl font-semibold font-mono text-text-main">{section.title}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {section.projects.map((project) => (
              <ProjectCard {...project} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Layout>

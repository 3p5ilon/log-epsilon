---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404" desc="Page not found">
  <section>
    <h1 class="text-2xl font-semibold">404</h1>
    <div class="mt-5 flex items-start gap-2 text-text-muted italic text-[15px]">
      <span class="shrink-0 text-theme-link">&gt;</span>
      <p>no such file or directory, type `cd ~` to return {" "}
        <a
          href="/"
          class="text-theme-link hover:underline"
        >
          home
        </a>.
      </p>
    </div> 
  </section>
</Layout>

---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";

export async function getStaticPaths() {
  const blogs = await getCollection("blog", ({ data }) => !data.draft);
  const notes = await getCollection("notes", ({ data }) => !data.draft);
  const allPosts = [...blogs, ...notes];

  const tags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))];

  return tags.map((tag) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.tags?.includes(tag))
      .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout title={`Posts tagged with ${tag}`} desc={`All posts tagged with ${tag} on site.`}>
  <section>
    <h1 class="text-2xl font-semibold">tag:<span class="text-theme-accent">[{tag}]</span></h1>
    <!-- <div class="mt-5 flex items-start gap-2 text-text-muted italic">
      <span class="shrink-0 text-theme-link">&gt;</span>
      <p>posts tagged with <span class="not-italic">{tag}</span>
      </p>
    </div>  -->
    <div class="mt-6">
      <PostList posts={posts} />
    </div>
  </section>
</Layout>

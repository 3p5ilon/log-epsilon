---
import Layout from "../layouts/Layout.astro";
import Books from "../components/now/Books.astro";
import Films from "../components/now/Films.astro";
import Shows from "../components/now/Shows.astro";
import Music from "../components/now/Music.astro";
import Games from "../components/now/Games.astro";
import { getNowFeeds } from "../lib/now";

const { books, films, shows, music, games } = await getNowFeeds();
---

<Layout title="now" desc="what i'm doing right now">
  <section class="space-y-8">
    <header class="space-y-4">
      <h1 class="text-2xl font-semibold text-text-main">now</h1>
      <div class="mt-5 flex items-start gap-2 text-text-muted italic">
        <span class="shrink-0 text-theme-link">&gt;</span>
        <p>
          what i'm doing right now, inspired by{" "}
          <a
            href="https://nownownow.com/about"
            target="_blank"
            rel="noopener noreferrer"
            class="text-theme-link not-italic hover:underline"
          >
            nownownow.com
          </a>
        </p>
      </div>
    </header>

    <div class="mt-8 space-y-8">
      <Books books={books} />
      <Films films={films} />
      <Shows shows={shows} />
      <Music music={music} />
      <Games games={games} />
    </div>
  </section>
</Layout>

<script src="../scripts/now.ts"></script>

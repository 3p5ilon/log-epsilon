---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<Layout title="Blog" desc={`Thoughts, ideas, and reflections on whatever interests me`}>
   <section>
    <h1 class="text-2xl font-semibold">logs</h1>
    <div class="mt-5 flex items-start gap-2 text-text-muted italic text-[15px]">
      <span class="shrink-0 text-theme-link">&gt;</span>
      <p>thoughts, ideas, and reflections on whatever interests me</p>
    </div>
    <div class="mt-6">
      <PostList posts={posts} collection="blog" />
    </div>
  </section>
</Layout>

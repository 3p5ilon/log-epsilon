---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";

const posts = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<Layout title="Notes" desc={`Technical notes, references, and things I'm learning`}>
  <section>
    <h1 class="text-2xl font-semibold">notes</h1>
    <div class="mt-5 flex items-start gap-2 text-text-muted italic text-[15px]">
      <span class="shrink-0 text-theme-link">&gt;</span>
      <p>technical notes, references, and things i'm learning</p>
    </div>
    <div class="mt-6">
      <PostList posts={posts} collection="notes" />
    </div>
  </section>
</Layout>

---
import type { LetterboxdMovie } from "../../lib/now";

interface Props {
  movie: LetterboxdMovie | null;
}

const { movie } = Astro.props;
---

<section class="space-y-4 pb-4" id="watching-section">
  <div class="flex items-baseline justify-between">
    <h2 class="text-xl font-semibold font-mono text-text-main">watching</h2>
    <a
      href="https://letterboxd.com/3p5ilon/"
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm font-mono text-theme-accent hover:text-theme-link no-underline"
    >
      [/letterboxd]
    </a>
  </div>
  <div class="flex items-start gap-3.5 sm:gap-5" id="watching-content">
    {movie?.image ? (
      <a href={movie.link} target="_blank" rel="noopener noreferrer" class="shrink-0 block" id="movie-img-link">
        <img
          id="movie-img"
          src={movie.image}
          alt={movie.title}
          class="w-28 sm:w-36 aspect-[2/3] object-cover rounded-none block border border-theme-divider/40"
          loading="lazy"
        />
      </a>
    ) : (
      <div
        id="movie-img-placeholder"
        class="w-28 sm:w-36 aspect-[2/3] bg-theme-divider/10 border border-theme-divider/40 shrink-0 flex items-center justify-center text-text-muted text-xs font-mono"
      >
        [no poster]
      </div>
    )}
    <div class="flex-1 min-w-0">
      {movie ? (
        <>
          <a
            id="movie-title"
            href={movie.link}
            target="_blank"
            rel="noopener noreferrer"
            class="group font-mono font-semibold text-base text-text-main hover:text-theme-link block leading-tight break-words"
          >
            <span class="group-hover:underline">{movie.title}</span>
            {movie.year && (
              <span id="movie-year" class="text-sm font-normal text-text-muted group-hover:text-theme-link ml-1.5 inline-block no-underline">
                ({movie.year})
              </span>
            )}
          </a>
          {movie.stars && (
            <span id="movie-stars" class="mt-1 block text-base sm:text-lg text-ctp-yellow leading-tight">
              {movie.stars}
            </span>
          )}
        </>
      ) : (
        <p id="movie-error" class="font-mono text-base text-text-muted italic my-0">
          currently unavailable
        </p>
      )}
    </div>
  </div>
</section>

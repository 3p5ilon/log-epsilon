---
import type { GoodreadsBook } from "../../lib/now/types";

interface Props {
  book: GoodreadsBook;
}

const { book } = Astro.props;
---

<section class="space-y-4 pb-4">
  <div class="flex items-baseline justify-between">
    <h2 class="text-xl font-semibold font-mono text-text-main">reading</h2>
    <a
      href="https://www.goodreads.com/akshattalapa"
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm font-mono text-theme-accent hover:text-theme-link no-underline"
    >
      [/goodreads]
    </a>
  </div>
  <div class="flex items-start gap-3.5 sm:gap-5">
    {book.image && (
      <a href={book.link} target="_blank" rel="noopener noreferrer" class="shrink-0 block">
        <img
          id="book-img"
          src={book.image}
          alt={book.title}
          class="w-28 sm:w-36 aspect-[2/3] object-cover rounded-none block"
          loading="lazy"
        />
      </a>
    )}
    <div class="flex-1 min-w-0">
      <a
        id="book-title"
        href={book.link}
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono font-semibold text-base text-text-main hover:text-theme-link block leading-tight hover:underline break-words"
      >
        {book.title}
      </a>
      {book.author && (
        <p id="book-subtitle" class="text-sm text-text-muted mt-1.5 mb-0 leading-relaxed">
          {book.author}
        </p>
      )}
    </div>
  </div>
</section>

---
// oneko.js: https://github.com/adryd325/oneko.js
---
<span
  id="neko-home"
  style="position:relative;display:inline-block;width:32px;height:0;overflow:visible;"
  title="Click Neko to wake up!"
></span>

<script>
(function oneko() {
  const isReducedMotion =
    window.matchMedia("(prefers-reduced-motion: reduce)").matches === true;

  if (isReducedMotion) return;

  let nekoEl: HTMLDivElement | null = null;

  type State = "SLEEPING" | "WAKING" | "CHASING" | "RETURNING";
  let state: State = "SLEEPING";

  let nekoPosX = 0;
  let nekoPosY = 0;
  let mousePosX = 0;
  let mousePosY = 0;

  let frameCount = 0;
  let idleTime = 0;
  let idleAnimation: string | null = null;
  let idleAnimationFrame = 0;
  let wakingTimer = 0;
  let lastFrameTimestamp: number | undefined;

  const nekoSpeed = 10;

  const spriteSets: Record<string, [number, number][]> = {
    idle: [[-3, -3]],
    alert: [[-7, -3]],
    scratchSelf: [
      [-5, 0],
      [-6, 0],
      [-7, 0],
    ],
    scratchWallN: [
      [0, 0],
      [0, -1],
    ],
    scratchWallS: [
      [-7, -1],
      [-6, -2],
    ],
    scratchWallE: [
      [-2, -2],
      [-2, -3],
    ],
    scratchWallW: [
      [-4, 0],
      [-4, -1],
    ],
    tired: [[-3, -2]],
    sleeping: [
      [-2, 0],
      [-2, -1],
    ],
    N: [
      [-1, -2],
      [-1, -3],
    ],
    NE: [
      [0, -2],
      [0, -3],
    ],
    E: [
      [-3, 0],
      [-3, -1],
    ],
    SE: [
      [-5, -1],
      [-5, -2],
    ],
    S: [
      [-6, -3],
      [-7, -2],
    ],
    SW: [
      [-5, -3],
      [-6, -1],
    ],
    W: [
      [-4, -2],
      [-4, -3],
    ],
    NW: [
      [-1, 0],
      [-1, -1],
    ],
  };

  function getHomeEl(): HTMLElement | null {
    return document.getElementById("neko-home");
  }

  function getHomePos(): { x: number; y: number } {
    const el = getHomeEl();
    if (el) {
      const rect = el.getBoundingClientRect();
      return { x: rect.left + rect.width / 2, y: rect.top };
    }
    return { x: window.innerWidth - 48, y: 24 };
  }

  function setSprite(name: string, frame: number) {
    if (!nekoEl) return;
    const set = spriteSets[name];
    if (!set) return;
    const sprite = set[frame % set.length]!;
    nekoEl.style.backgroundPosition = `${sprite[0] * 32}px ${sprite[1] * 32}px`;
  }

  function resetIdleAnimation() {
    idleAnimation = null;
    idleAnimationFrame = 0;
  }

  function attachToHome() {
    const home = getHomeEl();
    if (!home || !nekoEl) return;
    nekoEl.style.position = "absolute";
    nekoEl.style.left = "0px";
    nekoEl.style.top = "-16px";
    nekoEl.style.transform = "none";
    nekoEl.style.zIndex = "";
    if (nekoEl.parentElement !== home) {
      home.appendChild(nekoEl);
    }
  }

  function detachToBody() {
    if (!nekoEl) return;
    const home = getHomePos();
    nekoPosX = home.x;
    nekoPosY = home.y;
    nekoEl.style.position = "fixed";
    nekoEl.style.left = `${nekoPosX - 16}px`;
    nekoEl.style.top = `${nekoPosY - 16}px`;
    nekoEl.style.zIndex = "2147483647";
    if (nekoEl.parentElement !== document.body) {
      document.body.appendChild(nekoEl);
    }
  }

  function idle() {
    idleTime += 1;

    if (
      idleTime > 10 &&
      Math.floor(Math.random() * 200) === 0 &&
      idleAnimation == null
    ) {
      let available = ["sleeping", "scratchSelf"];
      if (nekoPosX < 32) available.push("scratchWallW");
      if (nekoPosY < 32) available.push("scratchWallN");
      if (nekoPosX > window.innerWidth - 32) available.push("scratchWallE");
      if (nekoPosY > window.innerHeight - 32) available.push("scratchWallS");
      idleAnimation = available[Math.floor(Math.random() * available.length)]!;
    }

    switch (idleAnimation) {
      case "sleeping":
        if (idleAnimationFrame < 8) {
          setSprite("tired", 0);
          break;
        }
        setSprite("sleeping", Math.floor(idleAnimationFrame / 4));
        if (idleAnimationFrame > 192) {
          resetIdleAnimation();
        }
        break;
      case "scratchWallN":
      case "scratchWallS":
      case "scratchWallE":
      case "scratchWallW":
      case "scratchSelf":
        setSprite(idleAnimation, idleAnimationFrame);
        if (idleAnimationFrame > 9) {
          resetIdleAnimation();
        }
        break;
      default:
        setSprite("idle", 0);
        return;
    }
    idleAnimationFrame += 1;
  }

  function frame() {
    frameCount += 1;

    if (state === "SLEEPING") {
      setSprite("sleeping", Math.floor(frameCount / 4));
      if (nekoEl) nekoEl.title = "Click Neko to wake up!";
      return;
    }

    if (state === "WAKING") {
      setSprite("alert", 0);
      wakingTimer += 1;
      if (wakingTimer > 4) {
        state = "CHASING";
        wakingTimer = 0;
      }
      return;
    }

    const home = getHomePos();

    if (state === "RETURNING") {
      const diffX = nekoPosX - home.x;
      const diffY = nekoPosY - home.y;
      const distance = Math.sqrt(diffX * diffX + diffY * diffY);

      if (distance < nekoSpeed || distance < 16) {
        state = "SLEEPING";
        attachToHome();
        setSprite("sleeping", 0);
        if (nekoEl) nekoEl.title = "Click Neko to wake up!";
        return;
      }

      let direction = diffY / distance > 0.5 ? "N" : "";
      direction += diffY / distance < -0.5 ? "S" : "";
      direction += diffX / distance > 0.5 ? "W" : "";
      direction += diffX / distance < -0.5 ? "E" : "";
      setSprite(direction, frameCount);

      nekoPosX -= (diffX / distance) * nekoSpeed;
      nekoPosY -= (diffY / distance) * nekoSpeed;

      if (nekoEl) {
        nekoEl.style.left = `${nekoPosX - 16}px`;
        nekoEl.style.top = `${nekoPosY - 16}px`;
        nekoEl.title = "Neko is going back to sleep...";
      }
      return;
    }

    if (state === "CHASING") {
      const diffX = nekoPosX - mousePosX;
      const diffY = nekoPosY - mousePosY;
      const distance = Math.sqrt(diffX * diffX + diffY * diffY);

      if (distance < nekoSpeed || distance < 48) {
        idle();
        if (nekoEl) nekoEl.title = "Click Neko to send back to sleep!";
        return;
      }

      idleAnimation = null;
      idleAnimationFrame = 0;

      if (idleTime > 1) {
        setSprite("alert", 0);
        idleTime = Math.min(idleTime, 7);
        idleTime -= 1;
        return;
      }

      let direction = diffY / distance > 0.5 ? "N" : "";
      direction += diffY / distance < -0.5 ? "S" : "";
      direction += diffX / distance > 0.5 ? "W" : "";
      direction += diffX / distance < -0.5 ? "E" : "";
      setSprite(direction, frameCount);

      nekoPosX -= (diffX / distance) * nekoSpeed;
      nekoPosY -= (diffY / distance) * nekoSpeed;

      nekoPosX = Math.min(Math.max(16, nekoPosX), window.innerWidth - 16);
      nekoPosY = Math.min(Math.max(16, nekoPosY), window.innerHeight - 16);

      if (nekoEl) {
        nekoEl.style.left = `${nekoPosX - 16}px`;
        nekoEl.style.top = `${nekoPosY - 16}px`;
        nekoEl.title = "Click Neko to send back to sleep!";
      }
    }
  }

  function onAnimationFrame(timestamp: number) {
    if (!nekoEl || !nekoEl.isConnected) return;
    if (!lastFrameTimestamp) lastFrameTimestamp = timestamp;
    if (timestamp - lastFrameTimestamp > 100) {
      lastFrameTimestamp = timestamp;
      frame();
    }
    requestAnimationFrame(onAnimationFrame);
  }

  function handleClick(e: Event) {
    e.stopPropagation();
    if (state === "SLEEPING") {
      detachToBody();
      state = "WAKING";
      wakingTimer = 0;
    } else if (state === "CHASING" || state === "WAKING") {
      window.scrollTo({ top: 0, behavior: "smooth" });
      state = "RETURNING";
    } else if (state === "RETURNING") {
      state = "WAKING";
      wakingTimer = 0;
    }
  }

  function init() {
    const existing = document.getElementById("oneko") as HTMLDivElement | null;
    if (existing) {
      nekoEl = existing;
    } else {
      nekoEl = document.createElement("div");
      nekoEl.id = "oneko";
      nekoEl.setAttribute("aria-hidden", "true");
      nekoEl.style.width = "32px";
      nekoEl.style.height = "32px";
      nekoEl.style.cursor = "pointer";
      nekoEl.style.pointerEvents = "auto";
      nekoEl.style.imageRendering = "pixelated";
      nekoEl.style.backgroundImage = "url('/neko.gif')";
      nekoEl.title = "Click Neko to wake up!";
    }

    attachToHome();
    setSprite("sleeping", 0);

    nekoEl.addEventListener("click", handleClick);
    getHomeEl()?.addEventListener("click", handleClick);

    window.addEventListener("mousemove", (event) => {
      mousePosX = event.clientX;
      mousePosY = event.clientY;
    });

    window.addEventListener(
      "touchmove",
      (event) => {
        if (event.touches.length > 0) {
          mousePosX = event.touches[0]!.clientX;
          mousePosY = event.touches[0]!.clientY;
        }
      },
      { passive: true }
    );

    lastFrameTimestamp = undefined;
    requestAnimationFrame(onAnimationFrame);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>
